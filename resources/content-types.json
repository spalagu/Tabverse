    { "id": "c-family", "extensions": ["c", "h", "cc", "cpp", "hpp", "m", "mm"], "handler": "code", "view": true, "edit": true },
    { "id": "source-code", "extensions": ["rs", "go", "kt", "dart", "lua", "scala", "cs", "vue", "gql", "graphql", "dockerfile"], "handler": "code", "view": true, "edit": true },
    { "id": "python", "extensions": ["py"], "handler": "code", "view": true, "edit": true },
    { "id": "ruby", "extensions": ["rb"], "handler": "code", "view": true, "edit": true },
    { "id": "php", "extensions": ["php"], "handler": "code", "view": true, "edit": true },
    { "id": "java", "extensions": ["java"], "handler": "code", "view": true, "edit": true },
    { "id": "swift", "extensions": ["swift"], "handler": "code", "view": true, "edit": true },
    { "id": "protobuf", "extensions": ["proto"], "handler": "code", "view": true, "edit": true },
    { "id": "r", "extensions": ["r"], "handler": "code", "view": true, "edit": true },
    { "id": "sql-script", "extensions": ["sql"], "handler": "code", "view": true, "edit": true },
    { "id": "patch", "extensions": ["diff", "patch"], "handler": "code", "view": true, "edit": true },
