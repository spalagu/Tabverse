    { "id": "certificate", "extensions": ["pem", "crt", "cer", "der", "csr"], "handler": "certificate", "view": true, "edit": false },
    { "id": "image", "extensions": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "ico", "svg", "avif", "heic"], "handler": "image", "view": true, "edit": false },
    { "id": "pdf", "extensions": ["pdf"], "handler": "pdf", "view": true, "edit": false },
    { "id": "office", "extensions": ["docx", "xlsx", "xlsm", "pptx", "doc", "xls"], "handler": "office", "view": true, "edit": false },
    { "id": "audio", "extensions": ["mp3", "wav", "m4a", "aac", "flac", "ogg", "opus"], "handler": "media", "view": true, "edit": false },
    { "id": "video", "extensions": ["mp4", "m4v", "mov", "webm"], "handler": "media", "view": true, "edit": false },
    { "id": "archive", "extensions": ["zip", "tar", "gz", "tgz", "bz2", "xz", "zst", "7z", "rar"], "handler": "archive", "view": true, "edit": false },
    { "id": "sqlite", "extensions": ["db", "db3", "sqlite", "sqlite3"], "handler": "sqlite", "view": true, "edit": false },
